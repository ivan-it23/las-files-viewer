<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AMK.LasViewer.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
    RequestedTheme="Light">
    <!--
        Тема закреплена светлой, как в «Визуализации данных»: планшет будет
        рисоваться собственными цветами, и тёмный фон системы сделал бы его
        нечитаемым. Акцентная палитра задана явно по той же причине — иначе
        она берётся из персонализации Windows конкретной машины.
    -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <muxc:XamlControlsResources>
                    <muxc:XamlControlsResources.MergedDictionaries>
                        <ResourceDictionary>
                            <ResourceDictionary.ThemeDictionaries>
                                <ResourceDictionary x:Key="Default">
                                    <Color x:Key="SystemAccentColor">#FF0078D7</Color>
                                    <Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
                                    <Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
                                    <Color x:Key="SystemAccentColorLight3">#FFA6D8FF</Color>
                                    <Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
                                    <Color x:Key="SystemAccentColorDark2">#FF004275</Color>
                                    <Color x:Key="SystemAccentColorDark3">#FF002642</Color>
                                </ResourceDictionary>
                                <ResourceDictionary x:Key="Light">
                                    <Color x:Key="SystemAccentColor">#FF0078D7</Color>
                                    <Color x:Key="SystemAccentColorLight1">#FF429CE3</Color>
                                    <Color x:Key="SystemAccentColorLight2">#FF76B9ED</Color>
                                    <Color x:Key="SystemAccentColorLight3">#FFA6D8FF</Color>
                                    <Color x:Key="SystemAccentColorDark1">#FF005A9E</Color>
                                    <Color x:Key="SystemAccentColorDark2">#FF004275</Color>
                                    <Color x:Key="SystemAccentColorDark3">#FF002642</Color>
                                </ResourceDictionary>
                            </ResourceDictionary.ThemeDictionaries>
                        </ResourceDictionary>
                    </muxc:XamlControlsResources.MergedDictionaries>
                </muxc:XamlControlsResources>
            </ResourceDictionary.MergedDictionaries>

            <SolidColorBrush x:Key="PanelBorderBrush" Color="#FFD6D6D6" />
            <SolidColorBrush x:Key="PanelHeaderBackground" Color="#FFF3F3F3" />
            <SolidColorBrush x:Key="PlaceholderForeground" Color="#FF767676" />

            <!-- Кнопка-значок в заголовке боковой панели: как кнопки панели агента. -->
            <Style x:Key="PaneIconButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Padding" Value="8,6" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>

<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="AMK.LasViewer.App.Controls.DataTableView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AMK.LasViewer.App.Controls">

    <!--
        Строки виртуализированы: ListView создаёт элементы только для видимой
        части. Горизонтальная прокрутка вынесена во внешний ScrollViewer, чтобы
        заголовки столбцов двигались вместе со строками.
    -->
    <ScrollViewer
        HorizontalScrollMode="Auto"
        HorizontalScrollBarVisibility="Auto"
        VerticalScrollMode="Disabled"
        VerticalScrollBarVisibility="Disabled">
        <Grid x:Name="TableRoot" HorizontalAlignment="Left">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <local:TableRowView x:Name="HeaderRow" IsHeader="True" />

            <ListView
                x:Name="RowsList"
                Grid.Row="1"
                SelectionMode="Extended"
                IsItemClickEnabled="False">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="MinHeight" Value="22" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    </Style>
                </ListView.ItemContainerStyle>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <local:TableRowView />
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </ScrollViewer>
</UserControl>

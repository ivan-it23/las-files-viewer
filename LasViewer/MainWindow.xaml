<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.LasViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AMK.LasViewer.App.Controls">

    <Grid
        x:Name="RootGrid"
        Background="White"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Меню и кнопка проверки обновлений в одной строке. -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
        <MenuBar Grid.Column="0">
            <MenuBarItem Title="Файл">
                <MenuFlyoutItem Text="Новый проект" Click="NewProjectMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="N" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Открыть проект…" Click="OpenProjectMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Сохранить проект" Click="SaveProjectMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE74E;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem Text="Сохранить проект как…" Click="SaveProjectAsMenuItem_Click">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control,Shift" Key="S" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Открыть LAS…" Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CloseFileMenuItem" Text="Закрыть файл" Click="CloseFileMenuItem_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutSubItem Text="Экспорт планшета">
                    <MenuFlyoutItem Text="В SVG (вектор)…" Click="ExportSvgMenuItem_Click" />
                    <MenuFlyoutItem Text="В PNG (видимый участок)…" Click="ExportPngMenuItem_Click" />
                </MenuFlyoutSubItem>
                <MenuFlyoutItem Text="Печать…" Click="PrintMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE749;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="P" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Выход" Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Планшет">
                <MenuFlyoutItem Text="Совместный планшет…" Click="CombinedTabletMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem x:Name="TemplateMenu" Title="Шаблон" />
            <MenuBarItem Title="Движок">
                <MenuFlyoutItem Text="Перезапустить движок" Click="RestartEngineMenuItem_Click" />
                <MenuFlyoutItem Text="Открыть папку журналов" Click="OpenLogsMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>
            <Button
                Grid.Column="1"
                Content="Проверить обновления"
                VerticalAlignment="Stretch"
                Padding="12,0"
                Background="Transparent"
                BorderThickness="0"
                Click="CheckUpdatesButton_Click" />
        </Grid>

        <Grid Grid.Row="1" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Проект: открытые файлы, их кривые и пометки. -->
            <Grid Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelHeaderBackground}" Padding="12,8">
                    <TextBlock x:Name="ProjectTitle" Text="Проект" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                </Border>
                <TreeView
                    x:Name="ProjectTree"
                    Grid.Row="1"
                    SelectionMode="Single"
                    CanDragItems="True"
                    CanReorderItems="False"
                    AllowDrop="False"
                    DragItemsStarting="ProjectTree_DragItemsStarting"
                    RightTapped="ProjectTree_RightTapped"
                    ItemInvoked="ProjectTree_ItemInvoked" />
                <TextBlock
                    x:Name="ProjectEmptyText"
                    Grid.Row="1"
                    Margin="12"
                    Foreground="{StaticResource PlaceholderForeground}"
                    TextWrapping="Wrap"
                    Text="Файлы не открыты. Файл → Открыть LAS (Ctrl+O), перетащите LAS-файлы в окно или откройте проект (Ctrl+Shift+O)." />
            </Grid>

            <!-- Просмотр активного файла. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
                    <SelectorBarItem Text="Планшет" Tag="tablet" IsSelected="True" />
                    <SelectorBarItem Text="Данные" Tag="data" />
                    <SelectorBarItem Text="Заголовок" Tag="header" />
                </SelectorBar>

                <Grid
                    x:Name="TabletToolbar"
                    Grid.Row="1"
                    Padding="12,4"
                    ColumnSpacing="10"
                    Background="{StaticResource PanelHeaderBackground}"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="ScaleCombo"
                        Grid.Column="1"
                        Width="160"
                        SelectionChanged="ScaleCombo_SelectionChanged">
                        <ComboBoxItem Content="Весь интервал" Tag="fit" />
                        <ComboBoxItem Content="1:100" Tag="100" />
                        <ComboBoxItem Content="1:200" Tag="200" />
                        <ComboBoxItem Content="1:500" Tag="500" />
                        <ComboBoxItem Content="1:1000" Tag="1000" />
                        <ComboBoxItem Content="1:2000" Tag="2000" />
                        <ComboBoxItem Content="1:5000" Tag="5000" />
                    </ComboBox>
                    <TextBlock
                        x:Name="ScaleText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}" />
                    <CheckBox
                        x:Name="SyncCheck"
                        Grid.Column="3"
                        Content="Общая глубина"
                        IsChecked="True"
                        Visibility="Collapsed"
                        Click="SyncCheck_Click"
                        ToolTipService.ToolTip="Прокрутка, масштаб и курсор планшетов рядом совпадают" />
                    <TextBlock
                        Grid.Column="4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}"
                        TextTrimming="CharacterEllipsis"
                        Text="Колесо — прокрутка · Ctrl + колесо — масштаб" />
                </Grid>

                <Grid Grid.Row="2">
                    <controls:TabletPanels x:Name="Panels" />
                    <controls:DataTableView x:Name="DataTable" Visibility="Collapsed" />
                    <controls:HeaderView x:Name="HeaderPanel" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}"
                        Text="Откройте LAS-файл: Файл → Открыть LAS (Ctrl+O) или перетащите файлы в окно." />
                </Grid>
            </Grid>

            <!-- Агент. -->
            <Border Grid.Column="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
                <controls:AgentPane x:Name="AgentPanel" />
            </Border>
        </Grid>

        <!-- Строка состояния. -->
        <Grid Grid.Row="2" Background="{StaticResource PanelHeaderBackground}" Padding="10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="EngineIndicator" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock
                x:Name="EngineStatusText"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center" />
            <HyperlinkButton
                x:Name="EngineDetailsButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="4,0"
                VerticalAlignment="Center"
                Content="Подробнее"
                Visibility="Collapsed"
                Click="EngineDetailsButton_Click" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource PlaceholderForeground}" />
        </Grid>
    </Grid>
</Window>

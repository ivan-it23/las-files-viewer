<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="AMK.LasViewer.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:AMK.LasViewer.App.Controls">

    <Grid
        x:Name="RootGrid"
        Background="White"
        AllowDrop="True"
        DragOver="RootGrid_DragOver"
        Drop="RootGrid_Drop">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <MenuBar Grid.Row="0">
            <MenuBarItem Title="Файл">
                <MenuFlyoutItem Text="Открыть…" Click="OpenMenuItem_Click">
                    <MenuFlyoutItem.Icon>
                        <FontIcon Glyph="&#xE8E5;" />
                    </MenuFlyoutItem.Icon>
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="O" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutItem x:Name="CloseFileMenuItem" Text="Закрыть файл" Click="CloseFileMenuItem_Click" IsEnabled="False">
                    <MenuFlyoutItem.KeyboardAccelerators>
                        <KeyboardAccelerator Modifiers="Control" Key="W" />
                    </MenuFlyoutItem.KeyboardAccelerators>
                </MenuFlyoutItem>
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="Выход" Click="ExitMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Движок">
                <MenuFlyoutItem Text="Перезапустить движок" Click="RestartEngineMenuItem_Click" />
                <MenuFlyoutItem Text="Открыть папку журналов" Click="OpenLogsMenuItem_Click" />
            </MenuBarItem>
            <MenuBarItem Title="Справка">
                <MenuFlyoutItem Text="Проверить обновления" Click="CheckUpdatesMenuItem_Click" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem Text="О программе" Click="AboutMenuItem_Click" />
            </MenuBarItem>
        </MenuBar>

        <Grid Grid.Row="1" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,1,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" MinWidth="180" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" MinWidth="240" />
            </Grid.ColumnDefinitions>

            <!-- Проект: открытые файлы и их кривые. -->
            <Grid Grid.Column="0" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="0,0,1,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelHeaderBackground}" Padding="12,8">
                    <TextBlock Text="Проект" FontWeight="SemiBold" />
                </Border>
                <TreeView
                    x:Name="ProjectTree"
                    Grid.Row="1"
                    SelectionMode="Single"
                    ItemInvoked="ProjectTree_ItemInvoked" />
                <TextBlock
                    x:Name="ProjectEmptyText"
                    Grid.Row="1"
                    Margin="12"
                    Foreground="{StaticResource PlaceholderForeground}"
                    TextWrapping="Wrap"
                    Text="Файлы не открыты. Файл → Открыть (Ctrl+O) или перетащите LAS-файлы в окно." />
            </Grid>

            <!-- Просмотр активного файла. -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <SelectorBar x:Name="ViewSelector" SelectionChanged="ViewSelector_SelectionChanged">
                    <SelectorBarItem Text="Планшет" Tag="tablet" IsSelected="True" />
                    <SelectorBarItem Text="Данные" Tag="data" />
                    <SelectorBarItem Text="Заголовок" Tag="header" />
                    <SelectorBarItem Text="Сводка" Tag="summary" />
                </SelectorBar>

                <Grid
                    x:Name="TabletToolbar"
                    Grid.Row="1"
                    Padding="12,4"
                    ColumnSpacing="10"
                    Background="{StaticResource PanelHeaderBackground}"
                    Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Масштаб" VerticalAlignment="Center" />
                    <ComboBox
                        x:Name="ScaleCombo"
                        Grid.Column="1"
                        Width="160"
                        SelectionChanged="ScaleCombo_SelectionChanged">
                        <ComboBoxItem Content="Весь интервал" Tag="fit" />
                        <ComboBoxItem Content="1:100" Tag="100" />
                        <ComboBoxItem Content="1:200" Tag="200" />
                        <ComboBoxItem Content="1:500" Tag="500" />
                        <ComboBoxItem Content="1:1000" Tag="1000" />
                        <ComboBoxItem Content="1:2000" Tag="2000" />
                        <ComboBoxItem Content="1:5000" Tag="5000" />
                    </ComboBox>
                    <TextBlock
                        x:Name="ScaleText"
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}" />
                    <TextBlock
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}"
                        TextTrimming="CharacterEllipsis"
                        Text="Колесо — прокрутка · Ctrl + колесо — масштаб · перетаскивание — сдвиг" />
                </Grid>

                <Grid Grid.Row="2">
                    <controls:LogTablet x:Name="Tablet" ViewChanged="Tablet_ViewChanged" />
                    <controls:DataTableView x:Name="DataTable" Visibility="Collapsed" />
                    <controls:HeaderView x:Name="HeaderPanel" Visibility="Collapsed" />
                    <controls:SummaryView x:Name="SummaryPanel" Visibility="Collapsed" />
                    <TextBlock
                        x:Name="EmptyHint"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        TextAlignment="Center"
                        Foreground="{StaticResource PlaceholderForeground}"
                        Text="Откройте LAS-файл: Файл → Открыть (Ctrl+O) или перетащите файлы в окно." />
                </Grid>
            </Grid>

            <!-- Агент. -->
            <Grid Grid.Column="2" BorderBrush="{StaticResource PanelBorderBrush}" BorderThickness="1,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{StaticResource PanelHeaderBackground}" Padding="12,8">
                    <TextBlock Text="Агент" FontWeight="SemiBold" />
                </Border>
                <TextBlock
                    Grid.Row="1"
                    Margin="12"
                    Foreground="{StaticResource PlaceholderForeground}"
                    TextWrapping="Wrap"
                    Text="Здесь будет чат с ИИ-агентом." />
            </Grid>
        </Grid>

        <!-- Строка состояния. -->
        <Grid Grid.Row="2" Background="{StaticResource PanelHeaderBackground}" Padding="10,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="EngineIndicator" Width="10" Height="10" VerticalAlignment="Center" />
            <TextBlock
                x:Name="EngineStatusText"
                Grid.Column="1"
                Margin="8,0,0,0"
                VerticalAlignment="Center" />
            <HyperlinkButton
                x:Name="EngineDetailsButton"
                Grid.Column="2"
                Margin="8,0,0,0"
                Padding="4,0"
                VerticalAlignment="Center"
                Content="Подробнее"
                Visibility="Collapsed"
                Click="EngineDetailsButton_Click" />
            <TextBlock
                x:Name="StatusText"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{StaticResource PlaceholderForeground}" />
        </Grid>
    </Grid>
</Window>
